# ── Copy this file to .env and fill in real values ───────────────────────────
# NEVER commit the real .env file to version control.

# PostgreSQL connection URL
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/tenantguard

# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_random_hex_secret

# JWT algorithm — HS256 is fine for local demo
JWT_ALGORITHM=HS256

# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Demo account passwords — change before any real deployment
TENANT_A_DEMO_PASSWORD=TenantA_demo_pw_2024
TENANT_B_DEMO_PASSWORD=TenantB_demo_pw_2024

# CORS — frontend origin
FRONTEND_ORIGIN=http://localhost:5173
